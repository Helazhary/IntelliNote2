# SmartNotes AI — backend environment (see docs/ENV_SETUP.md)
# Copy to .env and fill in values. NEVER commit .env (NFR-SEC-04).

# Database (local SQLite file, DEC-001)
DATABASE_URL=sqlite:///./smartnotes.db

# Auth — JWT + bcrypt (REQ-AUTH-04/05, NFR-SEC-02)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Anthropic — backend only, never shipped to frontend (NFR-SEC-04). Used in Phase 4b.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000
